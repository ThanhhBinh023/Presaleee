{
  "name": "presaleee-backend",
  "version": "0.1.0",
  "description": "Presaleee Backend Service (TypeScript / Express / pgvector)",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "db:setup": "tsx src/database/setupDatabase.ts",
    "db:migrate:auth": "tsx src/database/runAuthMigration.ts",
    "db:migrate": "tsx src/database/runPendingMigrations.ts",
    "test:e2e:auth": "node api_test/g1_g2_auth.e2e.mjs",
    "test:e2e:directory": "node api_test/g3_g4_directory.e2e.mjs",
    "test:e2e:pricing-leads": "node api_test/g5_g6_pricing_and_leads.e2e.mjs",
    "build": "tsc",
    "start": "node dist/index.js",

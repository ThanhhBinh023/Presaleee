{
  "name": "presaleee-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "Presaleee Monorepo - AI-Powered Presale & Proposal Platform (AI, Backend, Frontend)",
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "dev": "npm run dev:all",
    "dev:ai": "python ai/server.py",
    "dev:frontend": "npm run dev --workspace=frontend",
    "dev:backend": "npm run dev --workspace=backend",
    "dev:all": "concurrently -n \"AI,BE,FE\" -c \"magenta,green,cyan\" \"npm run dev:ai\" \"npm run dev:backend\" \"npm run dev:frontend\"",
    "db:setup": "npm run db:setup --workspace=backend",
    "build": "npm run build --workspaces --if-present",
    "build:frontend": "npm run build --workspace=frontend",
    "build:backend": "npm run build --workspace=backend",
    "lint": "npm run lint:frontend",
    "lint:frontend": "npm run lint --workspace=frontend",
    "test": "npm run test --workspaces --if-present"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  }
}
